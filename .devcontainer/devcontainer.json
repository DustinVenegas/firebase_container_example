{
  "name": "example_firebase_devcontainer",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.extension.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces",
  "remoteUser": "node",
  "postCreateCommand": "npm install",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, "firestore-emulator:8080", "firestore-emulator:9000", "firestore-emulator:9199"],
  "portsAttributes": {
    "3000": {
      "label": "Application (API)",
      "onAutoForward": "notify"
    },
    "firestore-emulator:8080": {
      "label": "Firestore",
      "onAutoForward": "notify"
    },
    "firestore-emulator:9000": {
      "label": "Emulator UI",
      "onAutoForward": "notify"
    },
    "firestore-emulator:9199": {
      "label": "Auth",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {}
    }
  }
}
